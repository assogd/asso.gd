# Are.na content is cached indefinitely and refreshed through /api/revalidate-arena.
# Set PREVIEW_MODE=true only on the preview Netlify site.
PREVIEW_MODE=false
# Set to true (together with PREVIEW_MODE=true) to fetch fresh Are.na data without
# showing the Publish button, e.g. on the dev site.
HIDE_PUBLISH_BUTTON=false
# Set the same random value as REVALIDATE_TOKEN on the production site.
PUBLISH_TOKEN=
# Preview only: the production site's revalidation endpoint.
PRODUCTION_REVALIDATE_URL=https://asso.gd/api/revalidate-arena
# Production only: shared secret used to authorize revalidation requests.
REVALIDATE_TOKEN=